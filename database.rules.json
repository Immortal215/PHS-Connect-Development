{
  "rules": {
    ".read": false,
    ".write": false,
    "clubs": {
      ".read": true,
      ".indexOn": ["lastUpdated"],
      "$club_id": {
        "announcements": {
          "$announcement_id": {
            ".write": "auth != null && (root.child('clubMemberships').child($club_id).child(auth.uid).child('role').val() === 'leader' || auth.token.phsSuperAdmin === true)",
            "peopleSeen": {
              ".write": "auth != null"
            }
          }
        },
        "chatIDs": {
          ".write": "auth != null && (root.child('clubMemberships').child($club_id).child(auth.uid).child('role').exists() || auth.token.phsSuperAdmin === true)"
        },
        "chatEnabled": {
          ".write": "auth != null && (root.child('clubMemberships').child($club_id).child(auth.uid).child('role').val() === 'leader' || auth.token.phsSuperAdmin === true)",
          ".validate": "newData.isBoolean()"
        },
        "locationInSchoolCoordinates": {
          ".write": "auth != null && (root.child('clubMemberships').child($club_id).child(auth.uid).child('role').val() === 'leader' || auth.token.phsSuperAdmin === true)",
          ".validate": "newData.hasChildren(['0', '1']) && newData.child('0').isNumber() && newData.child('1').isNumber()"
        },
        "lastUpdated": {
          ".write": "auth != null && (root.child('clubMemberships').child($club_id).child(auth.uid).child('role').exists() || auth.token.phsSuperAdmin === true) && newData.isNumber()"
        },
        "meetingTimes": { ".write": false },
        "members": { ".write": false },
        "leaders": { ".write": false },
        "membersUIDs": { ".write": false },
        "leadersUIDs": { ".write": false },
        "pendingMemberRequests": { ".write": false }
      }
    },
    "users": {
      "$user_id": {
        ".read": "auth != null",
        ".write": false,
        "userID": {
          ".write": "auth != null && auth.uid === $user_id",
          ".validate": "newData.isString() && newData.val() === $user_id"
        },
        "favoritedClubs": {
          ".write": "auth != null && auth.uid === $user_id"
        },
        "userEmail": {
          ".write": "auth != null && auth.uid === $user_id",
          ".validate": "newData.isString() && auth.token.email != null && newData.val() === auth.token.email"
        },
        "userImage": {
          ".write": "auth != null && auth.uid === $user_id",
          ".validate": "newData.isString()"
        },
        "userName": {
          ".write": "auth != null && auth.uid === $user_id",
          ".validate": "newData.isString()"
        },
        "chatNotifStyles": {
          ".write": "auth != null && auth.uid === $user_id"
        },
        "mutedThreadsByChat": {
          ".write": "auth != null && auth.uid === $user_id"
        },
        "fcmToken": {
          ".write": false
        }
      }
    },
    "clubMemberships": {
      "$club_id": {
        "$user_id": {
          ".read": "auth != null && auth.uid === $user_id",
          ".write": false
        }
      }
    },
    "userClubMemberships": {
      "$user_id": {
        ".read": "auth != null && auth.uid === $user_id",
        ".write": false
      }
    },
    "clubJoinRequests": { ".read": false, ".write": false },
    "clubMeetings": {
      ".read": false,
      ".write": false,
      "$club_id": { ".indexOn": ["seriesID"] }
    },
    "clubCalendars": {
      ".read": false,
      ".write": false,
      "$club_id": {
        "latestChange": {
          ".read": "auth != null && (auth.token.phsSuperAdmin === true || (auth.token.email_verified === true && auth.token.email != null && root.child('clubMemberships').child($club_id).child(auth.uid).child('email').val() === auth.token.email.toLowerCase() && (root.child('clubMemberships').child($club_id).child(auth.uid).child('role').val() === 'member' || root.child('clubMemberships').child($club_id).child(auth.uid).child('role').val() === 'leader')))"
        }
      }
    },
    "meetingRSVPs": { ".read": false, ".write": false },
    "userRSVPIndex": { ".read": false, ".write": false },
    "calendarSubscriptions": { ".read": false, ".write": false },
    "calendarTokens": { ".read": false, ".write": false },
    "notificationDevices": { ".read": false, ".write": false },
    "notificationReadState": {
      "$user_id": {
        ".read": "auth != null && auth.uid === $user_id",
        ".write": false,
        ".indexOn": ["seenAt"]
      }
    },
    "internal": {
      ".read": false,
      ".write": false,
      "clubOperationExpirations": { ".indexOn": ["expiresAt"] },
      "meetingOperationExpirations": { ".indexOn": ".value" },
      "meetingNotificationJobExpirations": { ".indexOn": ".value" },
      "notificationRetryJobs": { ".indexOn": ["nextAttempt"] }
    },
    "chats": {
      ".read": true,
      "$chat_id": {
        ".write": "!data.exists() && auth != null && newData.child('clubID').isString() && !newData.child('messages').exists() && (root.child('clubMemberships').child(newData.child('clubID').val()).child(auth.uid).child('role').exists() || auth.token.phsSuperAdmin === true)",
        "messages": {
          ".indexOn": ["lastUpdated", "threadName"],
          "$message_id": {
            ".write": "auth != null && (root.child('clubMemberships').child(root.child('chats').child($chat_id).child('clubID').val()).child(auth.uid).child('role').exists() || auth.token.phsSuperAdmin === true) && ((data.child('threadName').val() !== 'announcements' && newData.child('threadName').val() !== 'announcements') || root.child('clubMemberships').child(root.child('chats').child($chat_id).child('clubID').val()).child(auth.uid).child('role').val() === 'leader' || auth.token.phsSuperAdmin === true)",
            "reactions": {
              "$emoji": {
                ".write": "auth != null && (root.child('clubMemberships').child(root.child('chats').child($chat_id).child('clubID').val()).child(auth.uid).child('role').exists() || auth.token.phsSuperAdmin === true)"
              }
            },
            "poll": {
              "votes": {
                "$user_id": {
                  ".write": "auth != null && auth.uid === $user_id && root.child('clubMemberships').child(root.child('chats').child($chat_id).child('clubID').val()).child(auth.uid).child('role').exists() && !data.exists() && newData.isString() && root.child('chats').child($chat_id).child('messages').child($message_id).child('threadName').val() === 'announcements' && root.child('chats').child($chat_id).child('messages').child($message_id).child('poll').child('options').child(newData.val()).exists()"
                }
              }
            },
            "lastUpdated": {
              ".write": "auth != null && (root.child('clubMemberships').child(root.child('chats').child($chat_id).child('clubID').val()).child(auth.uid).child('role').val() === 'leader' || auth.token.phsSuperAdmin === true) && newData.isNumber()"
            }
          }
        },
        "deletedMessages": {
          ".indexOn": ".value",
          "$message_id": {
            ".write": "auth != null && (root.child('clubMemberships').child(root.child('chats').child($chat_id).child('clubID').val()).child(auth.uid).child('role').exists() || auth.token.phsSuperAdmin === true) && (root.child('chats').child($chat_id).child('messages').child($message_id).child('threadName').val() !== 'announcements' || root.child('clubMemberships').child(root.child('chats').child($chat_id).child('clubID').val()).child(auth.uid).child('role').val() === 'leader' || auth.token.phsSuperAdmin === true)",
            ".validate": "newData.isNumber()"
          }
        },
        "pinned": {
          ".write": "auth != null && (root.child('clubMemberships').child(root.child('chats').child($chat_id).child('clubID').val()).child(auth.uid).child('role').exists() || auth.token.phsSuperAdmin === true)"
        }
      }
    },
    "global": {
      ".read": true,
      ".indexOn": ["lastUpdated"],
      ".write": "auth != null && auth.token.phsSuperAdmin === true"
    }
  }
}
